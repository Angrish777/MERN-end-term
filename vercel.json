{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "express"
    },
    "vite-project": {
      "root": "frontend/vite-project",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/assets/(.*)",
      "destination": {
        "service": "vite-project"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "vite-project",
        "path": "/index.html"
      }
    }
  ]
}
